{
  "name": "chromablind",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:ui": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src tests e2e *.ts *.json index.html",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "lucide-react": "^0.468.0",
    "opentype.js": "^1.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "svgpath": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.19.2",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.0.0 || >=24.0.0"
  }
}
